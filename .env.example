# Backend configuration. Copy to `.env` and adjust.
# Every key here maps to a field on Settings in backend/app/core/config.py.

# --- Auth ---
# Signs dispatcher JWTs (POST /api/v1/auth/login). Change it for any shared
# deployment; rotating it logs every dispatcher out.
SECRET_KEY=SUPER_SECRET_KEY_CHANGE_THIS_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# --- WebSocket (dispatcher live feed) ---
# The dashboard sends its JWT; this static token is the fallback for scripted
# clients and must match VITE_WS_TOKEN in frontend/.env if you use it.
WS_ACCESS_TOKEN=sentinel-demo-ws-token

# --- Database ---
# Set DATABASE_URL to bypass the POSTGRES_* fields entirely, e.g. for a laptop
# without Docker (run.bat does this automatically):
#   DATABASE_URL=sqlite+aiosqlite:///./sentinel_dev.db
DATABASE_URL=
POSTGRES_SERVER=localhost
# Also used by docker-compose.dev.yml as the host port. Set 5433 if a native
# PostgreSQL service already owns 5432 (it will silently win the connection).
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinel
# Echo every SQL statement to stdout. Leave false: the log would include
# incident descriptions and reporter phone numbers.
SQL_ECHO=false

# --- AI processing ---
# celery: enqueue on Redis, needs `celery -A backend.app.tasks.celery_app.celery_app worker --pool=solo`
# inline: run the pipeline as a background task inside the API process (no Redis/worker)
AI_PROCESSING_MODE=celery

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Semantic embeddings (deduplication) ---
# Deduplication only clusters when sentence-transformers is installed:
#   pip install sentence-transformers
# Without it the pipeline falls back to a hash vector that is flagged
# non-semantic, and clustering correctly refuses to run rather than merging
# unrelated incidents. Model weights (all-MiniLM-L6-v2, ~90MB) are downloaded
# once on first use and cached in ~/.cache/huggingface.

# --- AI provider ---
# One of: llamaserver, llamacpp, lmstudio, openai
# llamaserver talks to llama.cpp's llama-server.exe over HTTP. Start it first:
#   llama-server -m <model>.gguf --port 8080 -c 4096 -ngl 99   (use the CUDA build)
AI_PROVIDER=llamaserver
LLAMASERVER_API_URL=http://localhost:8080/v1
LLAMASERVER_MODEL=local-gguf
LLAMA_MODEL_PATH=models/gemma-4-e4b-qat.gguf
LMSTUDIO_API_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# --- Anti-bot ---
# Leave blank. When blank, Turnstile verification is skipped entirely
# (backend/app/core/security.py) - a deliberate open door in this project.
#
# Do NOT set this until a Turnstile widget exists in the frontend. Nothing
# currently sends a token, and an enabled Turnstile treats a missing token as a
# failure, so setting the key alone will 403 every incident report.
TURNSTILE_SECRET_KEY=
