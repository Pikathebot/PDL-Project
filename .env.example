# Backend configuration. Copy to `.env` and adjust.
# Every key here maps to a field on Settings in backend/app/core/config.py.

# --- WebSocket (dispatcher live feed) ---
# Shared demo token the dashboard presents when opening /ws/incidents.
# Must match VITE_WS_TOKEN in frontend/.env, or the handshake is rejected (4001).
# This is a demo credential, not authentication - see core/websocket_manager.py.
WS_ACCESS_TOKEN=sentinel-demo-ws-token

# --- Database ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinel

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Semantic embeddings (deduplication) ---
# Deduplication only clusters when sentence-transformers is installed:
#   pip install sentence-transformers
# Without it the pipeline falls back to a hash vector that is flagged
# non-semantic, and clustering correctly refuses to run rather than merging
# unrelated incidents. Model weights (all-MiniLM-L6-v2, ~90MB) are downloaded
# once on first use and cached in ~/.cache/huggingface.

# --- AI provider ---
# One of: llamacpp, lmstudio, openai
AI_PROVIDER=llamacpp
LLAMA_MODEL_PATH=models/gemma-4-e4b-qat.gguf
LMSTUDIO_API_URL=http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1

# --- Anti-bot ---
# Leave blank. When blank, Turnstile verification is skipped entirely
# (backend/app/core/security.py) - a deliberate open door in this project.
#
# Do NOT set this until a Turnstile widget exists in the frontend. Nothing
# currently sends a token, and an enabled Turnstile treats a missing token as a
# failure, so setting the key alone will 403 every incident report.
TURNSTILE_SECRET_KEY=
