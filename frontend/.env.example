# Frontend configuration. Copy to `frontend/.env` and adjust.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Token sent to the backend when opening the incident WebSocket.
# Must match WS_ACCESS_TOKEN in the backend .env, or the dashboard's live feed
# is rejected with close code 4001 and shows "Live feed unavailable".
VITE_WS_TOKEN=sentinel-demo-ws-token
