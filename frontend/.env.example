# Frontend configuration. Copy to `frontend/.env` and adjust.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Fallback token for the incident WebSocket when no dispatcher is logged in
# (the dashboard normally sends its JWT). Must match WS_ACCESS_TOKEN in the
# backend .env if used; a mismatch closes the feed with code 4001.
VITE_WS_TOKEN=sentinel-demo-ws-token
